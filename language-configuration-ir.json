{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "autoCloseBefore": ":,=}])> \n\t",
  "wordPattern": "(-?\\b[0-9]+\\.[0-9]*(?:[eE][+-]?[0-9]+)?\\b|%[A-Za-z_][A-Za-z0-9_]*|%[0-9]+|@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*|![A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!//).*(?:\\{|(?:@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*.*:\\s*(?:![A-Za-z_][A-Za-z0-9_]*\\s*)*))\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(?:\\}|(?:@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*.*:\\s*(?:![A-Za-z_][A-Za-z0-9_]*\\s*)*)\\s*(//.*)?$)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*.*:\\s*(?:![A-Za-z_][A-Za-z0-9_]*\\s*)*(//.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  }
}
