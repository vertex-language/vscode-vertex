{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "markdown.vertex.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "fileTypes": [],
  "patterns": [
    {
      "include": "#vertex-vss-fenced-code-block"
    },
    {
      "include": "#vertex-vsx-fenced-code-block"
    },
    {
      "include": "#vertex-fenced-code-block"
    },
    {
      "include": "#vertex-ir-fenced-code-block"
    },
    {
