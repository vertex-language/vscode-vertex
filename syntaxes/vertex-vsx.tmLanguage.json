{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vertex Markup",
  "scopeName": "source.vtx.vsx",
  "fileTypes": [
    "vsx"
  ],
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#code"
    }
  ],
  "repository": {
    "shebang": {
      "match": "\\A#!.*$",
      "name": "comment.line.shebang.vertex"
    },
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#compiler-control"
        },
        {
          "include": "#markup"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#regex"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#package-declaration"
        },
        {
          "include": "#import-declaration"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#type-declaration"
        },
        {
          "include": "#variable-declaration"
        },
        {
          "include": "#enum-case"
        },
        {
          "include": "#accessors"
        },
        {
          "include": "#execution-modifier"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#pound-words"
        },
        {
          "include": "#macro-expansion"
        },
        {
          "include": "#types"
        },
        {
          "include": "#backtick-identifier"
        },
        {
          "include": "#special-identifiers"
        },
        {
          "include": "#argument-label"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#member-access"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#brace-block"
        },
        {
          "include": "#paren-group"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "name": "comment.block.documentation.vertex",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.vertex"
            }
          },
          "patterns": [
            {
              "include": "#nested-block-comment"
            },
            {
              "include": "#doc-markup"
            }
          ]
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.vertex",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.vertex"
            }
          },
          "patterns": [
            {
              "include": "#nested-block-comment"
            }
          ]
        },
        {
          "begin": "///",
          "end": "$",
          "name": "comment.line.triple-slash.documentation.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.vertex"
            }
          },
          "patterns": [
            {
              "include": "#doc-markup"
            }
          ]
        },
        {
          "match": "(//)\\s*(MARK|TODO|FIXME|NOTE|HACK|XXX)(:)?(.*)$",
          "name": "comment.line.double-slash.vertex",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.vertex"
            },
            "2": {
              "name": "keyword.other.comment-tag.vertex"
            },
            "3": {
              "name": "punctuation.separator.vertex"
            }
          }
        },
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.vertex"
            }
          }
        }
      ]
    },
    "nested-block-comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.nested.vertex",
      "patterns": [
        {
          "include": "#nested-block-comment"
        }
      ]
    },
    "doc-markup": {
      "patterns": [
        {
          "match": "(?<=^|///|\\*)\\s*(-)\\s+(Parameters?|Returns|Throws|Note|Warning|Important|Precondition|Postcondition|Complexity|SeeAlso|Author|Since|Version|Attention|Bug|Experiment|Invariant|Requires|Todo)\\b(?:\\s+((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)))?\\s*(:)",
          "captures": {
            "1": {
              "name": "punctuation.definition.list.vertex"
            },
            "2": {
              "name": "keyword.other.documentation.vertex"
            },
            "3": {
              "name": "variable.parameter.documentation.vertex"
            },
            "4": {
              "name": "punctuation.separator.vertex"
            }
          }
        },
        {
          "match": "`[^`]+`",
          "name": "markup.inline.raw.vertex"
        }
      ]
    },
    "compiler-control": {
      "patterns": [
        {
          "begin": "^\\s*(#)(if|elseif)\\b",
          "end": "(?=//|/\\*)|$",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.directive.conditional.vertex"
            },
            "1": {
              "name": "punctuation.definition.directive.vertex"
            }
          },
          "name": "meta.preprocessor.conditional.vertex",
          "patterns": [
            {
              "match": "\\b(os|arch|canImport|targetEnvironment|swift|compiler|hasFeature|hasAttribute|_endian|_pointerBitWidth|_runtime|_ptrauth|_hasAtomicBitWidth|_compiler_version)\\s*(?=\\()",
              "captures": {
                "1": {
                  "name": "support.function.condition.vertex"
                }
              }
            },
            {
              "match": "\\b(?:true|false)\\b",
              "name": "constant.language.boolean.vertex"
            },
            {
              "match": "&&|\\|\\||!|>=|<",
              "name": "keyword.operator.logical.vertex"
            },
            {
              "include": "#numbers"
            },
            {
              "match": "[()]",
              "name": "punctuation.section.parens.vertex"
            },
            {
              "match": "(?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)",
              "name": "variable.other.condition.vertex"
            }
          ]
        },
        {
          "match": "^\\s*(#)(else|endif)\\b",
          "captures": {
            "0": {
              "name": "keyword.control.directive.conditional.vertex"
            },
            "1": {
              "name": "punctuation.definition.directive.vertex"
            }
          }
        },
        {
          "begin": "(#)(error|warning)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.directive.vertex"
            },
            "2": {
              "name": "keyword.control.directive.diagnostic.vertex"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.vertex"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "pound-words": {
      "patterns": [
        {
          "begin": "(#)(available|unavailable)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.keyword.vertex"
            },
            "2": {
              "name": "keyword.other.availability.vertex"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.vertex"
            }
          },
          "patterns": [
            {
              "match": "\\b(macOS|macOSApplicationExtension|iOS|iOSApplicationExtension|tvOS|watchOS|visionOS|macCatalyst|Linux|Windows|Android|FreeBSD|OpenBSD|WASI|Cygwin|Haiku)\\b",
              "name": "support.constant.platform.vertex"
            },
            {
              "match": "\\*",
              "name": "keyword.other.wildcard.vertex"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "match": "(#)(available|unavailable|selector|keyPath|sourceLocation)\\b",
          "captures": {
            "0": {
              "name": "keyword.other.pound.vertex"
            },
            "1": {
              "name": "punctuation.definition.keyword.vertex"
            }
          }
        },
        {
          "match": "(#)(file|fileID|filePath|line|column|function|dsohandle|colorLiteral|fileLiteral|imageLiteral)\\b",
          "captures": {
            "0": {
              "name": "support.variable.literal.vertex"
            },
            "1": {
              "name": "punctuation.definition.keyword.vertex"
            }
          }
        }
      ]
    },
    "macro-expansion": {
      "match": "(#)((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))",
      "captures": {
        "1": {
          "name": "punctuation.definition.macro.vertex"
        },
        "2": {
          "name": "entity.name.function.macro.vertex"
        }
      }
    },
    "attributes": {
      "patterns": [
        {
          "begin": "(@)((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.vertex"
            },
            "2": {
              "name": "storage.modifier.attribute.vertex"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.vertex"
            }
          },
          "name": "meta.attribute.vertex",
          "patterns": [
            {
              "match": "\\b((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))\\s*(:)",
              "captures": {
                "1": {
                  "name": "variable.parameter.attribute.vertex"
                },
                "2": {
                  "name": "punctuation.separator.vertex"
                }
              }
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "match": "(@)((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))",
          "name": "meta.attribute.vertex",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.vertex"
            },
            "2": {
              "name": "storage.modifier.attribute.vertex"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vertex"
            }
          },
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "match": "\\\\(?:[0\\\\tnr\"\\']|u\\{[0-9A-Fa-f]{1,8}\\})",
              "name": "constant.character.escape.vertex"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.vertex"
            }
          ]
        },
        {
          "begin": "#\"\"\"",
          "end": "\"\"\"#",
          "name": "string.quoted.triple.raw.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vertex"
            }
          },
          "patterns": [
            {
              "include": "#raw-interpolation"
            },
            {
              "match": "\\\\#(?:[0\\\\tnr\"\\']|u\\{[0-9A-Fa-f]{1,8}\\})",
              "name": "constant.character.escape.vertex"
            }
          ]
        },
        {
          "begin": "(#{2,})\"\"\"",
          "end": "\"\"\"\\1",
          "name": "string.quoted.triple.raw.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vertex"
            }
          },
          "patterns": []
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vertex"
            }
          },
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "match": "\\\\(?:[0\\\\tnr\"\\']|u\\{[0-9A-Fa-f]{1,8}\\})",
              "name": "constant.character.escape.vertex"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.vertex"
            }
          ]
        },
        {
          "begin": "#\"",
          "end": "\"#|$",
          "name": "string.quoted.double.raw.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vertex"
            }
          },
          "patterns": [
            {
              "include": "#raw-interpolation"
            },
            {
              "match": "\\\\#(?:[0\\\\tnr\"\\']|u\\{[0-9A-Fa-f]{1,8}\\})",
              "name": "constant.character.escape.vertex"
            }
          ]
        },
        {
          "begin": "(#{2,})\"",
          "end": "\"\\1|$",
          "name": "string.quoted.double.raw.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.vertex"
            }
          },
          "patterns": []
        }
      ]
    },
    "interpolation": {
      "begin": "\\\\\\(",
      "end": "\\)",
      "contentName": "source.vtx",
      "name": "meta.embedded.line.vertex",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.vertex"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.vertex"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "raw-interpolation": {
      "begin": "\\\\#\\(",
      "end": "\\)",
      "contentName": "source.vtx",
      "name": "meta.embedded.line.vertex",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.vertex"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.vertex"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "begin": "(#+)/",
          "end": "/\\1",
          "name": "string.regexp.extended.vertex",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.regexp.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.regexp.vertex"
            }
          },
          "patterns": [
            {
              "include": "#regex-guts"
            }
          ]
        },
        {
          "match": "(?<=^|[\\s(\\[{,:=;!&|?])(/)(?![\\s/*])((?:\\\\.|[^/\\\\\\n])+)(/)(?![\\w/])",
          "name": "string.regexp.vertex",
          "captures": {
            "1": {
              "name": "punctuation.definition.string.begin.regexp.vertex"
            },
            "2": {
              "patterns": [
                {
                  "include": "#regex-guts"
                }
              ]
            },
            "3": {
              "name": "punctuation.definition.string.end.regexp.vertex"
            }
          }
        }
      ]
    },
    "regex-guts": {
      "patterns": [
        {
          "match": "\\\\[dDwWsSbBnrt]",
          "name": "constant.character.escape.backslash.regexp"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.regexp"
        },
        {
          "match": "[*+?]|\\{\\d+(?:,\\d*)?\\}",
          "name": "keyword.operator.quantifier.regexp"
        },
        {
          "match": "[|^$]",
          "name": "keyword.operator.regexp"
        },
        {
          "match": "\\[\\^?|\\]",
          "name": "punctuation.definition.character-class.regexp"
        },
        {
          "match": "\\((?:\\?(?:<(?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)>|[:=!]|<[=!]))?|\\)",
          "name": "punctuation.definition.group.regexp"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*(?:\\.[0-9A-Fa-f][0-9A-Fa-f_]*)?[pP][+-]?[0-9][0-9_]*\\b",
          "name": "constant.numeric.float.hexadecimal.vertex"
        },
        {
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b",
          "name": "constant.numeric.integer.hexadecimal.vertex"
        },
        {
          "match": "\\b0o[0-7][0-7_]*\\b",
          "name": "constant.numeric.integer.octal.vertex"
        },
        {
          "match": "\\b0b[01][01_]*\\b",
          "name": "constant.numeric.integer.binary.vertex"
        },
        {
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\\b",
          "name": "constant.numeric.float.decimal.vertex"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.decimal.vertex"
        },
        {
          "match": "(?<![.\\w])[0-9][0-9A-Za-z_]*[A-Za-z_][0-9A-Za-z_]*\\b",
          "name": "invalid.illegal.numeric.vertex"
        }
      ]
    },
    "package-declaration": {
      "match": "^\\s*(package)\\s+(?!(?:func|var|let|class|struct|enum|init|subscript|actor|protocol|extension|case|typealias|deinit|operator|macro|precedencegroup|import|associatedtype|public|private|fileprivate|internal|open|package|mutating|nonmutating|lazy|weak|unowned|convenience|required|dynamic|final|override|indirect|optional|nonisolated|distributed|infix|prefix|postfix|borrowing|consuming|__consuming|_const|_local|static)\\b)((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))\\s*(?=$|//|;)",
      "captures": {
        "1": {
          "name": "keyword.other.package.vertex"
        },
        "2": {
          "name": "entity.name.namespace.vertex"
        }
      }
    },
    "import-declaration": {
      "patterns": [
        {
          "begin": "\\b(import)\\s*(\\()",
          "end": "\\)",
          "name": "meta.import.vertex",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.vertex"
            },
            "2": {
              "name": "punctuation.section.imports.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.imports.end.vertex"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "(?:\\b((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))\\s+)?(\")([^\"]*)(\")",
              "captures": {
                "1": {
                  "name": "entity.name.namespace.alias.vertex"
                },
                "2": {
                  "name": "punctuation.definition.string.begin.vertex"
                },
                "3": {
                  "name": "string.quoted.double.import-path.vertex"
                },
                "4": {
                  "name": "punctuation.definition.string.end.vertex"
                }
              }
            }
          ]
        },
        {
          "begin": "\\b(import)\\s+(?=(?:(?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)\\s+)?\")",
          "end": "(?<=\")|$",
          "name": "meta.import.vertex",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.vertex"
            }
          },
          "patterns": [
            {
              "match": "(?:\\b((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))\\s+)?(\")([^\"]*)(\")",
              "captures": {
                "1": {
                  "name": "entity.name.namespace.alias.vertex"
                },
                "2": {
                  "name": "punctuation.definition.string.begin.vertex"
                },
                "3": {
                  "name": "string.quoted.double.import-path.vertex"
                },
                "4": {
                  "name": "punctuation.definition.string.end.vertex"
                }
              }
            }
          ]
        },
        {
          "match": "\\b(import)\\s+(?:(typealias|struct|class|enum|protocol|let|var|func)\\s+)?((?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)(?:\\.(?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*))*)",
          "name": "meta.import.vertex",
          "captures": {
            "1": {
              "name": "keyword.control.import.vertex"
            },
            "2": {
              "name": "storage.type.vertex"
            },
            "3": {
              "name": "entity.name.namespace.vertex"
            }
          }
        }
      ]
    },
    "function-declaration": {
      "begin": "\\b(func)\\b|(?<!\\.)\\b(init|subscript)\\b([?!])?(?=\\s*[<(])",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.vertex"
        },
        "2": {
          "name": "storage.type.function.vertex"
        },
        "3": {
          "name": "keyword.operator.optional.vertex"
        }
      },
      "end": "(?<=\\})|$",
      "name": "meta.definition.function.vertex",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "\\G\\s*(\\()(?=\\s*(?:(?:[A-Za-z_\\p{L}][A-Za-z0-9_\\p{L}\\p{N}]*)|`[^`]+`)\\s*:)",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.receiver.begin.vertex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.receiver.end.vertex"
            }
          },
