{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vertex IR",
  "scopeName": "source.vtxir",
  "fileTypes": [
    "vir"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#module-header"
    },
    {
      "include": "#struct-body"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#axis"
    },
    {
      "include": "#branch"
    },
    {
      "include": "#references"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#field-init"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "begin": "//",
      "end": "$",
      "name": "comment.line.double-slash.vir",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.vir"
        }
      }
    },
    "strings": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.vir",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.vir"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.vir"
        }
      },
      "patterns": [
        {
          "match": "\\\\(?:[nrtabfv0\\\\\"]|x[0-9A-Fa-f]{2})",
          "name": "constant.character.escape.vir"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.vir"
        }
      ]
    },
    "module-header": {
      "patterns": [
        {
          "match": "^\\s*(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.module.vir"
            },
            "2": {
              "name": "entity.name.namespace.vir"
            }
          }
        },
        {
          "match": "^\\s*(use)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.use.vir"
            }
          }
        },
        {
          "begin": "^\\s*(layout)\\s*(\\{)",
          "end": "\\}",
          "name": "meta.layout.vir",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.layout.vir"
            },
            "2": {
              "name": "punctuation.section.block.begin.vir"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.vir"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "\\b(abi|endian|ptrbits|stackalign|extfloat|vector|halffloat)\\b",
              "name": "variable.other.property.layout.vir"
            },
            {
              "match": "\\b(?:i1|i8|i16|i32|i64|i128|f16|bf16|f32|f64|f80|f128|ptr|v128)\\b",
              "name": "storage.type.vir"
            },
            {
              "match": "\\b[0-9]+\\b",
              "name": "constant.numeric.integer.vir"
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
              "name": "constant.language.layout.vir"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.vir"
            }
          ]
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(type)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "name": "storage.type.type.vir"
            },
            "2": {
              "name": "entity.name.type.vir"
            }
          }
        },
        {
          "match": "\\b(global)\\s+(?:(ro|rw|tls|shared)\\s+)?(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "name": "storage.type.global.vir"
            },
            "2": {
              "name": "storage.modifier.domain.vir"
            },
            "3": {
              "name": "entity.name.variable.global.vir"
            }
          }
        },
        {
          "match": "\\b(func)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.vir"
            },
            "2": {
              "name": "entity.name.function.vir"
            }
          }
        },
        {
          "match": "\\b(alias)\\s+(func|global)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "name": "storage.type.alias.vir"
            },
            "2": {
              "name": "storage.type.vir"
            },
            "3": {
              "name": "entity.name.function.vir"
            },
            "4": {
              "name": "variable.other.symbol.vir"
            }
          }
        },
        {
          "match": "^\\s*(![A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.name.tag.metadata.vir"
            },
            "2": {
              "name": "keyword.operator.assignment.vir"
            }
          }
        },
        {
          "match": "^\\s*(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)(?=\\s*(?::|\\(|\\s+pad\\b))",
          "captures": {
            "1": {
              "name": "entity.name.label.vir"
            }
          }
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "match": "\\b(call|tail_call|invoke|ptr\\.getaddr)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#instructions"
                }
              ]
            },
            "2": {
              "name": "entity.name.function.call.vir"
            }
          }
        },
        {
          "match": "\\b(br|to|unwind|ptr\\.blockaddr)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#instructions"
                },
                {
                  "include": "#keywords"
                }
              ]
            },
            "2": {
              "name": "entity.name.label.vir"
            }
          }
        },
        {
          "match": "\\b(sret|byval|ptr\\.alloc|ptr\\.va_arg_ref\\s+%[A-Za-z0-9_.]+\\s*,|sizeof|alignof|offsetof)\\s+(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#instructions"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#registers"
                },
                {
                  "include": "#punctuation"
                }
              ]
            },
            "2": {
              "name": "entity.name.type.vir"
            }
          }
        },
        {
          "match": "(%[A-Za-z0-9_.]+)\\s*(:)\\s*(@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*)",
          "captures": {
            "1": {
              "name": "variable.other.register.vir"
            },
            "2": {
              "name": "punctuation.separator.vir"
            },
            "3": {
              "name": "entity.name.type.vir"
            }
          }
        },
        {
          "match": "@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*",
          "name": "variable.other.symbol.vir"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "match": "\\b((?:i1|i8|i16|i32|i64|i128|f16|bf16|f32|f64|f80|f128|ptr|v128))(\\.)([a-z][a-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.namespace.vir"
            },
            "2": {
              "name": "punctuation.accessor.vir"
            },
            "3": {
              "name": "support.function.instruction.vir"
            }
          }
        },
        {
          "match": "\\b(?:br|brif|br_table|brind|return|trap|resume|tail_call|tail_callind|invoke|invokeind)\\b",
          "name": "keyword.control.terminator.vir"
        },
        {
          "match": "\\b(?:call|callind)\\b",
          "name": "keyword.control.call.vir"
        },
        {
          "match": "\\b(?:memcpy|memmove|memset|memcmp|fence|barrier|va_start|va_end|va_copy)\\b",
          "name": "support.function.instruction.vir"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:type|global|import|func|alias|asm)\\b",
          "name": "storage.type.vir"
        },
        {
          "match": "\\b(struct|union)\\b",
          "name": "storage.type.$1.vir"
        },
        {
          "match": "\\b(?:export|internal|hidden|protected|dllimport|dllexport|weak|common)\\b",
          "name": "storage.modifier.linkage.vir"
        },
        {
          "match": "\\b(?:ro|rw|tls|shared)\\b",
          "name": "storage.modifier.domain.vir"
        },
        {
          "match": "(?<![\\w-])(global-dynamic|local-dynamic|initial-exec|local-exec)(?![\\w-])",
          "name": "constant.language.tls-model.vir"
        },
        {
          "match": "\\b(?:section|comdat|align|tlsmodel|nounwind|personality|returns_twice|naked|noreturn|packed|at|zeroed|volatile|goto|clobber)\\b",
          "name": "storage.modifier.vir"
        },
        {
          "match": "\\b(?:byval|sret|zext|sext|noalias|swiftself|swiftasync|swiftindirect|swifterror|narrow8s|narrow8u|narrow16s|narrow16u)\\b",
          "name": "storage.modifier.attribute.vir"
        },
        {
          "match": "\\b(?:ccc|fastcc|preserve_most|preserve_all|stdcall|fastcall|thiscall|vectorcall|ms_abi|sysv_abi|kernel)\\b",
          "name": "storage.modifier.callconv.vir"
        },
        {
          "match": "\\b(?:unordered|monotonic|acquire|release|acq_rel|seq_cst|singlethread)\\b",
          "name": "constant.language.ordering.vir"
        },
        {
          "match": "\\b(?:workgroup|device|system)\\b",
          "name": "constant.language.scope.vir"
        },
        {
          "match": "\\b(?:pad|cleanup|catch|filter|to|unwind)\\b",
          "name": "keyword.other.vir"
        },
        {
          "match": "\\b(?:reg|mem|imm)\\b",
          "name": "constant.language.constraint.vir"
        },
        {
          "match": "\\b(?:sizeof|alignof|offsetof)\\b",
          "name": "keyword.operator.symconst.vir"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.vir"
        },
        {
          "match": "\\b(?:module|use|layout)\\b",
          "name": "keyword.other.vir"
        }
      ]
    },
    "types": {
      "match": "(\\[)([0-9]+)(\\])|\\b((?:i1|i8|i16|i32|i64|i128|f16|bf16|f32|f64|f80|f128|ptr|v128))\\b(?!\\.)",
      "captures": {
        "1": {
          "name": "punctuation.definition.array.vir"
        },
        "2": {
          "name": "constant.numeric.integer.vir"
        },
        "3": {
          "name": "punctuation.definition.array.vir"
        },
        "4": {
          "name": "storage.type.vir"
        }
      }
    },
    "registers": {
      "match": "%[A-Za-z0-9_.]+",
      "name": "variable.other.register.vir"
    },
    "metadata": {
      "match": "![A-Za-z_][A-Za-z0-9_]*",
      "name": "entity.other.attribute-name.metadata.vir"
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![\\w.%@])-?(?:inf|nan(?::0x[0-9A-Fa-f]+)?)\\b",
          "name": "constant.numeric.float.special.vir"
        },
        {
          "match": "(?<![\\w.%@])-?0x[0-9A-Fa-f]+(?:\\.[0-9A-Fa-f]*)?[pP][+-]?[0-9]+\\b",
          "name": "constant.numeric.float.hexadecimal.vir"
        },
        {
          "match": "(?<![\\w.%@])-?0x[0-9A-Fa-f]+\\b",
          "name": "constant.numeric.integer.hexadecimal.vir"
        },
        {
          "match": "(?<![\\w.%@])-?[0-9]+(?:\\.[0-9]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b",
          "name": "constant.numeric.float.decimal.vir"
        },
        {
          "match": "(?<![\\w.%@])-?[0-9]+\\b",
          "name": "constant.numeric.integer.decimal.vir"
        }
      ]
    },
    "axis": {
      "match": "(?<=workitem_id|workgroup_id|workgroup_size|num_workgroups)\\s+\\b([xyz])\\b",
      "captures": {
        "1": {
          "name": "constant.language.axis.vir"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.variadic.vir"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.vir"
        },
        {
          "match": "[+-]",
          "name": "keyword.operator.arithmetic.vir"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.vir"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.vir"
        },
        {
          "match": "[{}]",
          "name": "punctuation.section.braces.vir"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.vir"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.brackets.vir"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.vir"
        }
      ]
    },
    "branch": {
      "begin": "\\b(br|brif|br_table|brind)\\b|\\b(asm)\\s+(goto)\\b",
      "end": "(?=//)|$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.terminator.vir"
        },
        "2": {
          "name": "support.function.instruction.vir"
        },
        "3": {
          "name": "keyword.control.terminator.vir"
        }
      },
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#keywords"
        },
        {
          "match": "@[A-Za-z_$?@.<>][A-Za-z0-9_$?@.<>]*",
          "name": "entity.name.label.vir"
        },
        {
          "include": "#metadata"
        },
        {
          "include": "#types"
        },
        {
          "include": "#registers"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "struct-body": {
      "begin": "\\b(struct|union)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "storage.type.$1.vir"
        },
        "2": {
          "name": "punctuation.section.braces.vir"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.vir"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "(?:^|(?<=[{,]))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s+(?=(?:i1|i8|i16|i32|i64|i128|f16|bf16|f32|f64|f80|f128|ptr|v128)\\b|@|\\[)",
          "captures": {
            "1": {
              "name": "variable.other.property.vir"
            }
          }
        },
        {
          "match": "\\b(at)\\b",
          "name": "storage.modifier.vir"
        },
        {
          "include": "#types"
        },
        {
          "include": "#references"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "field-init": {
      "match": "(?<=[{,])\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?==(?!=))",
      "captures": {
        "1": {
          "name": "variable.other.property.vir"
        }
      }
    }
  }
}
