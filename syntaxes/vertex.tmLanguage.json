{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vertex",
  "scopeName": "source.vtx",
  "fileTypes": ["vs"],
  "patterns": [
    { "include": "#shebang" },
    { "include": "#code" }
  ],
  "repository": {

    "shebang": {
      "name": "comment.line.number-sign.shebang.vertex",
      "match": "\\A#!.*$"
    },

    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#compiler-control" },
        { "include": "#attributes" },
        { "include": "#strings" },
        { "include": "#regex" },
        { "include": "#numbers" },
        { "include": "#package-declaration" },
        { "include": "#import-declaration" },
        { "include": "#function-declaration" },
        { "include": "#type-declaration" },
        { "include": "#variable-declaration" },
        { "include": "#execution-modifier" },
        { "include": "#keywords" },
        { "include": "#builtin-types" },
        { "include": "#backtick-identifier" },
        { "include": "#special-identifiers" },
        { "include": "#function-call" },
        { "include": "#member-access" },
        { "include": "#argument-label" },
        { "include": "#type-name" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.vertex",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.vertex" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.vertex" } },
          "patterns": [{ "include": "#nested-block-comment" }]
        },
        { "include": "#nested-block-comment" },
        {
          "name": "comment.line.triple-slash.documentation.vertex",
          "begin": "///",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.vertex" } },
          "end": "$"
        },
        {
          "name": "comment.line.double-slash.vertex",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.vertex" } },
          "end": "$",
          "patterns": [
            {
              "match": "\\b(MARK|TODO|FIXME|NOTE|WARNING):",
              "captures": { "1": { "name": "keyword.other.comment-tag.vertex" } }
            }
          ]
        }
      ]
    },

    "nested-block-comment": {
      "comment": "Block comments nest: /* /* */ */ is one comment.",
      "name": "comment.block.vertex",
      "begin": "/\\*",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.vertex" } },
      "end": "\\*/",
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.vertex" } },
      "patterns": [{ "include": "#nested-block-comment" }]
    },

    "compiler-control": {
      "patterns": [
        {
          "comment": "#if / #elseif conditions",
          "begin": "^\\s*(#(?:if|elseif))\\b",
          "beginCaptures": { "1": { "name": "keyword.control.directive.conditional.vertex" } },
          "end": "(?=//|/\\*)|$",
          "patterns": [
            {
              "name": "support.function.condition.vertex",
              "match": "\\b(os|arch|swift|compiler|canImport|targetEnvironment|hasFeature|hasAttribute|_endian|_pointerBitWidth|_runtime|_ptrauth|_hasAtomicBitWidth|_compiler_version)(?=\\s*\\()"
            },
            { "name": "constant.language.boolean.vertex", "match": "\\b(true|false)\\b" },
            { "name": "keyword.operator.logical.vertex", "match": "&&|\\|\\||!" },
            { "name": "keyword.operator.comparison.vertex", "match": ">=|<" },
            { "include": "#numbers" },
            { "include": "#punctuation" }
          ]
        },
        {
          "name": "keyword.control.directive.conditional.vertex",
          "match": "^\\s*#(?:else|endif)\\b"
        },
        {
          "name": "keyword.control.directive.vertex",
          "match": "#(?:sourceLocation|error|warning)\\b"
        },
        {
          "name": "keyword.control.availability.vertex",
          "match": "#(?:available|unavailable)\\b"
        },
        {
          "name": "support.variable.literal.vertex",
          "match": "#(?:file|fileID|filePath|line|column|function|dsohandle)\\b"
        },
        {
          "name": "support.function.pound.vertex",
          "match": "#(?:selector|keyPath|colorLiteral|fileLiteral|imageLiteral)\\b"
        },
        {
          "comment": "MacroExpansion: # followed by any other identifier",
          "match": "(#)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.macro.vertex" },
            "2": { "name": "entity.name.function.macro.vertex" }
          }
        }
      ]
    },

    "attributes": {
      "patterns": [
        {
          "begin": "((@)(?:[A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\()",
          "beginCaptures": {
            "1": { "name": "storage.modifier.attribute.vertex" },
            "2": { "name": "punctuation.definition.attribute.vertex" },
            "3": { "name": "punctuation.definition.arguments.begin.vertex" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.arguments.end.vertex" } },
          "name": "meta.attribute.vertex",
          "patterns": [{ "include": "#attribute-arguments" }]
        },
        {
          "match": "((@)(?:[A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "storage.modifier.attribute.vertex" },
            "2": { "name": "punctuation.definition.attribute.vertex" }
          }
        }
      ]
    },

    "attribute-arguments": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [{ "include": "#attribute-arguments" }]
        },
        { "include": "#code" }
      ]
    },

    "strings": {
      "patterns": [
        {
          "comment": "Raw multiline string: #\"\"\" … \"\"\"#, closed by the same run of #",
          "name": "string.quoted.triple.raw.vertex",
          "begin": "(#+)(\"\"\")",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vertex" } },
          "end": "(\"\"\")(\\1)",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.vertex" } },
          "patterns": [{ "include": "#raw-string-guts" }]
        },
        {
          "comment": "Raw string: #\"…\"#, closed by the same run of #",
          "name": "string.quoted.double.raw.vertex",
          "begin": "(#+)(\")",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vertex" } },
          "end": "(\")(\\1)|$",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.vertex" } },
          "patterns": [{ "include": "#raw-string-guts" }]
        },
        {
          "name": "string.quoted.triple.vertex",
          "begin": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vertex" } },
          "end": "\"\"\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.vertex" } },
          "patterns": [
            { "include": "#string-guts" },
            { "name": "constant.character.escape.newline.vertex", "match": "\\\\\\s*$" }
          ]
        },
        {
          "name": "string.quoted.double.vertex",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vertex" } },
          "end": "(\")|$",
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.vertex" } },
          "patterns": [{ "include": "#string-guts" }]
        }
      ]
    },

    "string-guts": {
      "patterns": [
        {
          "name": "meta.embedded.line.interpolation.vertex",
          "contentName": "source.vtx",
          "begin": "\\\\\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vertex" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vertex" } },
          "patterns": [
            { "include": "#interpolation-parens" },
            { "include": "#code" }
          ]
        },
        {
          "name": "constant.character.escape.vertex",
          "match": "\\\\(?:[0\\\\tnr\"']|u\\{[0-9A-Fa-f]{1,8}\\})"
        },
        {
          "name": "invalid.illegal.escape.vertex",
          "match": "\\\\[^\\s]"
        }
      ]
    },

    "raw-string-guts": {
      "comment": "In a raw string an escape is one only when the literal's own pound run follows the backslash. The run is not visible from here, so any \\#… form is accepted.",
      "patterns": [
        {
          "name": "meta.embedded.line.interpolation.vertex",
          "contentName": "source.vtx",
          "begin": "\\\\#+\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vertex" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vertex" } },
          "patterns": [
            { "include": "#interpolation-parens" },
            { "include": "#code" }
          ]
        },
        {
          "name": "constant.character.escape.vertex",
          "match": "\\\\#+(?:[0\\\\tnr\"']|u\\{[0-9A-Fa-f]{1,8}\\})"
        }
      ]
    },

    "interpolation-parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#interpolation-parens" },
        { "include": "#code" }
      ]
    },

    "regex": {
      "comment": "Extended regex literal #/…/#. A bare /…/ is not highlighted: without the parser it cannot be told apart from division.",
      "name": "string.regexp.vertex",
      "begin": "(#+)(/)",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.regexp.vertex" } },
      "end": "(/)(\\1)",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.regexp.vertex" } },
      "patterns": [
        { "name": "constant.character.escape.regexp.vertex", "match": "\\\\." },
        { "name": "keyword.operator.quantifier.regexp.vertex", "match": "[*+?]\\??|\\{\\d+(?:,\\d*)?\\}" },
        { "name": "keyword.operator.or.regexp.vertex", "match": "\\|" },
        { "name": "constant.other.character-class.set.regexp.vertex", "match": "\\[\\^?(?:\\\\.|[^\\]\\\\])*\\]" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hexadecimal.vertex",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*(?:\\.[0-9A-Fa-f][0-9A-Fa-f_]*)?[pP][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.vertex",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.vertex",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.vertex",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "invalid.illegal.numeric.vertex",
          "match": "\\b0(?:[xX]|[oObB])(?![0-9A-Fa-f])[A-Za-z0-9_]*|\\b0[XOB][0-9A-Za-z_]*"
        },
        {
          "name": "constant.numeric.float.decimal.vertex",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?[eE][+-]?[0-9][0-9_]*\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.vertex",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "package-declaration": {
      "comment": "`package Name` declares the module. `package` before a declaration keyword is the access modifier and falls through to #keywords.",
      "match": "\\b(package)\\s+(?!(?:func|var|let|struct|class|enum|protocol|extension|actor|init|deinit|subscript|typealias|associatedtype|macro|static|final|import|override|mutating|nonmutating|convenience|required|lazy|weak|unowned|indirect|nonisolated|isolated|dynamic|optional|prefix|postfix|infix|operator|precedencegroup|case)\\b)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.package.vertex" },
        "2": { "name": "entity.name.namespace.vertex" }
      }
    },

    "import-declaration": {
      "patterns": [
        {
          "comment": "Grouped folder imports: import ( \"a\"  alias \"b\" )",
          "begin": "\\b(import)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.vertex" },
            "2": { "name": "punctuation.section.parens.begin.vertex" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.parens.end.vertex" } },
          "name": "meta.import.vertex",
          "patterns": [
            { "include": "#comments" },
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+(?=\")",
              "captures": { "1": { "name": "entity.name.namespace.alias.vertex" } }
            },
            { "include": "#import-path-string" }
          ]
        },
        {
          "comment": "Folder import, optionally aliased: import geom \"./geometry\"",
          "match": "\\b(import)\\s+(?:([A-Za-z_][A-Za-z0-9_]*)\\s+)?(?=\")",
          "captures": {
            "1": { "name": "keyword.control.import.vertex" },
            "2": { "name": "entity.name.namespace.alias.vertex" }
          }
        },
        {
          "comment": "Module import, optionally of one declaration: import func Darwin.sqrt",
          "match": "\\b(import)\\s+(?:(typealias|struct|class|enum|protocol|let|var|func|macro)\\s+)?((?:[A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?:\\.(?:[A-Za-z_][A-Za-z0-9_]*|`[^`]+`|[-+*/%<>=!&|^~?.]+))*)",
          "captures": {
            "1": { "name": "keyword.control.import.vertex" },
            "2": { "name": "storage.type.import-kind.vertex" },
            "3": { "name": "entity.name.namespace.vertex" }
          }
        }
      ]
    },

    "import-path-string": {
      "name": "string.quoted.double.import.vertex",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.vertex" } },
      "end": "(\")|$",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.vertex" } }
    },

    "function-declaration": {
      "patterns": [
        {
          "comment": "Receiver method: func (v: borrowing Vec2) length()",
          "begin": "\\b(func)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)\\s*(:)\\s*(?:(borrowing|consuming|inout|__shared|__owned)\\s+)?",
          "beginCaptures": {
            "1": { "name": "storage.type.function.vertex" },
            "2": { "name": "punctuation.section.receiver.begin.vertex" },
            "3": { "name": "variable.parameter.receiver.vertex" },
            "4": { "name": "punctuation.separator.colon.vertex" },
            "5": { "name": "storage.modifier.ownership.vertex" }
          },
          "end": "(\\))\\s*([A-Za-z_][A-Za-z0-9_]*|`[^`]+`|[-+*/%<>=!&|^~?.]+)?",
          "endCaptures": {
            "1": { "name": "punctuation.section.receiver.end.vertex" },
            "2": { "name": "entity.name.function.vertex" }
          },
          "name": "meta.receiver.vertex",
          "patterns": [
            { "include": "#builtin-types" },
            { "include": "#keywords" },
            { "include": "#type-name" },
            { "include": "#punctuation" },
            { "include": "#operators" }
          ]
        },
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*|`[^`]+`|[-+*/%<>=!&|^~?.]+)",
          "captures": {
            "1": { "name": "storage.type.function.vertex" },
            "2": { "name": "entity.name.function.vertex" }
          }
        },
        {
          "match": "\\b(macro)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[(<])",
          "captures": {
            "1": { "name": "storage.type.function.macro.vertex" },
            "2": { "name": "entity.name.function.macro.vertex" }
          }
        },
        {
          "match": "\\b(init|deinit|subscript)\\b([?!])?",
          "captures": {
            "1": { "name": "storage.type.function.vertex" },
            "2": { "name": "keyword.operator.optional.vertex" }
          }
        }
      ]
    },

    "type-declaration": {
      "patterns": [
        {
          "comment": "`class func` / `class var` are modifiers, not declarations",
          "match": "\\b(struct|class|enum|protocol|extension|actor)\\s+(?!(?:func|var|let|subscript|override|final|static)\\b)((?:[A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "storage.type.vertex" },
            "2": { "name": "entity.name.type.vertex" }
          }
        },
        {
          "match": "\\b(typealias|associatedtype)\\s+([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)",
          "captures": {
            "1": { "name": "storage.type.alias.vertex" },
            "2": { "name": "entity.name.type.alias.vertex" }
          }
        },
        {
          "match": "\\b(precedencegroup)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.precedencegroup.vertex" },
            "2": { "name": "entity.name.type.precedencegroup.vertex" }
          }
        },
        {
          "match": "\\b(?:(prefix|infix|postfix)\\s+)?(operator)\\s+([-+*/%<>=!&|^~?.]+)",
          "captures": {
            "1": { "name": "storage.modifier.vertex" },
            "2": { "name": "storage.type.operator.vertex" },
            "3": { "name": "entity.name.function.operator.vertex" }
          }
        },
        {
          "comment": "Enum case declarations: case north, south(Int)",
          "match": "^\\s*(?:(indirect)\\s+)?(case)\\s+([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?=\\s*(?:[(,=]|$|//))",
          "captures": {
            "1": { "name": "storage.modifier.vertex" },
            "2": { "name": "keyword.control.case.vertex" },
            "3": { "name": "variable.other.enummember.vertex" }
          }
        }
      ]
    },

    "variable-declaration": {
      "match": "\\b(let|var)\\s+([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?=\\s*[:=,{]|\\s*$)",
      "captures": {
        "1": { "name": "storage.type.variable.vertex" },
        "2": { "name": "variable.other.declaration.vertex" }
      }
    },

    "execution-modifier": {
      "comment": "`kernel` and `graph` sit between the parameter clause (or its async/throws) and the result arrow or body.",
      "match": "(?:(?<=\\))|(?<=\\basync)|(?<=\\bthrows)|(?<=\\brethrows))\\s*\\b(kernel|graph)\\b(?=\\s*(?:->|\\{|where\\b|$))",
      "captures": {
        "1": { "name": "storage.modifier.execution.vertex" }
      }
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.vertex",
          "match": "\\b(if|else|guard|switch|case|default|for|in|while|repeat|do|break|continue|fallthrough|return|throw|defer|where|catch|yield|discard)\\b"
        },
        {
          "name": "keyword.control.exception.vertex",
          "match": "\\b(try)\\b[?!]?"
        },
        {
          "name": "keyword.control.async.vertex",
          "match": "\\b(await)\\b"
        },
        {
          "name": "keyword.control.import.vertex",
          "match": "\\b(import)\\b"
        },
        {
          "name": "storage.type.function.vertex",
          "match": "\\b(func|init|deinit|subscript|macro)\\b"
        },
        {
          "name": "storage.type.vertex",
          "match": "\\b(struct|class|enum|protocol|extension|actor|typealias|associatedtype|operator|precedencegroup)\\b"
        },
        {
          "name": "storage.type.variable.vertex",
          "match": "\\b(let|var)\\b"
        },
        {
          "name": "storage.modifier.access.vertex",
          "match": "\\b(public|private|fileprivate|internal|open|package)\\b"
        },
        {
          "name": "storage.modifier.vertex",
          "match": "\\b(static|final|override|mutating|nonmutating|lazy|weak|unowned|required|convenience|dynamic|optional|indirect|prefix|postfix|infix|distributed|nonisolated|isolated|nonsending|sending|consuming|borrowing|inout|__consuming|__owned|__shared|_const|_local)\\b"
        },
        {
          "name": "storage.modifier.effect.vertex",
          "match": "\\b(async|throws|rethrows|reasync)\\b"
        },
        {
          "name": "keyword.other.type.vertex",
          "match": "\\b(some|any|each)\\b(?=\\s+[A-Za-z_(\\[`])"
        },
        {
          "comment": "Ownership operators in expression position: consume x, copy x, borrow x",
          "name": "keyword.operator.ownership.vertex",
          "match": "\\b(consume|copy|borrow)\\b(?=\\s+[A-Za-z_`$])"
        },
        {
          "comment": "Accessors",
          "name": "storage.type.accessor.vertex",
          "match": "\\b(get|set|willSet|didSet|_read|_modify|unsafeAddress|unsafeMutableAddress)\\b(?=\\s*(?:\\{|\\(|$|async\\b|throws\\b|mutating\\b|nonmutating\\b))"
        },
        {
          "comment": "precedencegroup body",
          "name": "keyword.other.precedencegroup.vertex",
          "match": "\\b(higherThan|lowerThan|associativity|assignment)\\b(?=\\s*:)"
        },
        {
          "name": "keyword.operator.type.vertex",
          "match": "\\b(is|as)\\b[?!]?"
        },
        {
          "name": "variable.language.vertex",
          "match": "\\b(self|Self|super)\\b"
        },
        {
          "name": "constant.language.vertex",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.wildcard.vertex",
          "match": "\\b_\\b"
        },
        {
          "comment": "Metatype members",
          "match": "(\\.)(Type|Protocol|self|init)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.language.metatype.vertex" }
          }
        }
      ]
    },

    "builtin-types": {
      "patterns": [
        {
          "comment": "Vertex lowercase spellings; each aliases a Swift standard type",
          "name": "support.type.primitive.vertex",
          "match": "\\b(bool|int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|double|float64|string|char|void|never|any)\\b(?!\\s*:(?!:))"
        },
        {
          "name": "support.type.vertex",
          "match": "\\b(Bool|Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float|Float16|Float32|Float64|Float80|Double|String|Substring|Character|Void|Never|Any|AnyObject|AnyClass|Optional|Array|Dictionary|Set|Range|ClosedRange|Result|Error|Sendable|Copyable|Escapable|Equatable|Hashable|Comparable|Sequence|Collection|UnsafePointer|UnsafeMutablePointer|UnsafeRawPointer|UnsafeMutableRawPointer|UnsafeBufferPointer|UnsafeMutableBufferPointer|OpaquePointer)\\b"
        }
      ]
    },

    "backtick-identifier": {
      "comment": "A backtick-escaped spelling is an identifier whatever it holds",
      "name": "variable.other.escaped.vertex",
      "match": "`[^`\\n]+`",
      "captures": { "0": { "name": "variable.other.escaped.vertex" } }
    },

    "special-identifiers": {
      "patterns": [
        {
          "comment": "Implicit closure parameters $0, $1 …",
          "name": "variable.language.closure-parameter.vertex",
          "match": "\\$[0-9]+\\b"
        },
        {
          "comment": "Property-wrapper projections $value",
          "name": "variable.other.projected.vertex",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "function-call": {
      "patterns": [
        {
          "comment": "Method call through a selector: a.b(",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\(|\\{)",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "entity.name.function.call.vertex" }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.vertex" } }
        }
      ]
    },

    "member-access": {
      "patterns": [
        {
          "comment": "Tuple element: t.0",
          "match": "(\\.)([0-9]+)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.other.property.tuple.vertex" }
          }
        },
        {
          "comment": "Property access on an expression",
          "match": "(?<=[\\w)\\]?!`])(\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.other.property.vertex" }
          }
        },
        {
          "comment": "Implicit member expression: .north",
          "match": "(?<![\\w)\\]?!`])(\\.)([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.other.enummember.vertex" }
          }
        }
      ]
    },

    "argument-label": {
      "patterns": [
        {
          "comment": "Parameter and argument labels after ( or , on the same line: (by factor: T), f(x: 1)",
          "match": "(?<=[(,])\\s*(?:([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)\\s+)?([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)\\s*(?=:(?!:))",
          "captures": {
            "1": { "name": "entity.name.label.argument.vertex" },
            "2": { "name": "variable.parameter.vertex" }
          }
        },
        {
          "comment": "Labels opening a continuation line of a multi-line call or parameter list",
          "match": "^\\s*(?!(?:case|default|public|private|internal|fileprivate|open|package|get|set|willSet|didSet|higherThan|lowerThan|associativity|assignment)\\b)([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(?=:(?!:)\\s*\\S)",
          "captures": {
            "1": { "name": "entity.name.label.argument.vertex" },
            "2": { "name": "variable.parameter.vertex" }
          }
        }
      ]
    },

    "type-name": {
      "name": "entity.name.type.vertex",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.vertex", "match": "->" },
        { "name": "keyword.operator.range.vertex", "match": "\\.\\.\\.|\\.\\.<" },
        { "name": "keyword.operator.optional.chain.vertex", "match": "(?<=[\\w)\\]])[?!](?=\\.)" },
        { "name": "keyword.operator.nil-coalescing.vertex", "match": "\\?\\?" },
        { "name": "keyword.operator.comparison.vertex", "match": "===|!==|==|!=|<=|>=|~=" },
        { "name": "keyword.operator.overflow.vertex", "match": "&[-+*]=?|&<<=?|&>>=?" },
        { "name": "keyword.operator.assignment.compound.vertex", "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|\\|=|\\^=|&=" },
        { "name": "keyword.operator.logical.vertex", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.vertex", "match": "<<|>>|[&|^~]" },
        { "name": "keyword.operator.assignment.vertex", "match": "=" },
        { "name": "keyword.operator.arithmetic.vertex", "match": "[-+*/%]" },
        { "name": "keyword.operator.comparison.vertex", "match": "[<>]" },
        { "name": "keyword.operator.ternary.vertex", "match": "\\?" },
        { "name": "keyword.operator.address.vertex", "match": "(?<![\\w)\\]])&(?=[A-Za-z_`$])" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.vertex", "match": "," },
        { "name": "punctuation.terminator.statement.vertex", "match": ";" },
        { "name": "punctuation.separator.colon.vertex", "match": ":" },
        { "name": "punctuation.accessor.vertex", "match": "\\." },
        { "name": "punctuation.section.braces.vertex", "match": "[{}]" },
        { "name": "punctuation.section.brackets.vertex", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.vertex", "match": "[()]" }
      ]
    }
  }
}
