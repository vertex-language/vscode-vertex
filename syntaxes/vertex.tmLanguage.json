{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vertex",
  "scopeName": "source.vtx",
  "fileTypes": ["vtx", "vs"],

  "patterns": [
    { "include": "#comments" },
    { "include": "#build-clause" },
    { "include": "#package-clause" },
    { "include": "#declare-clause" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#language-constants" },
    { "include": "#expected" },
    { "include": "#foreign-initializer" },
    { "include": "#function-declarations" },
    { "include": "#type-declarations" },
    { "include": "#function-markers" },
    { "include": "#npu-namespace" },
    { "include": "#namespaces" },
    { "include": "#channel-methods" },
    { "include": "#removed-transfer" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#predeclared-types" },
    { "include": "#predeclared-constraints" },
    { "include": "#blank-identifier" },
    { "include": "#named-fields" },
    { "include": "#enum-shorthand" },
    { "include": "#tuple-access" },
    { "include": "#method-calls" },
    { "include": "#member-access" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],

  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.block.vertex",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.vertex" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.vertex" }
          }
        },
        {
          "name": "comment.line.double-slash.vertex",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.vertex" }
          },
          "end": "(?=$)"
        }
      ]
    },

    "build-clause": {
      "patterns": [
        {
          "match": "^\\s*\\b(build)\\s+(linux|windows|darwin|js|wasm|test)\\b",
          "captures": {
            "1": { "name": "keyword.control.build.vertex" },
            "2": { "name": "constant.language.build-tag.vertex" }
          }
        },
        {
          "match": "^\\s*\\b(build)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.build.vertex" },
            "2": { "name": "constant.other.build-tag.vertex" }
          }
        }
      ]
    },

    "package-clause": {
      "patterns": [
        {
          "match": "\\b(package)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.package.vertex" },
            "2": { "name": "entity.name.namespace.vertex" }
          }
        }
      ]
    },

    "declare-clause": {
      "patterns": [
        {
          "match": "\\b(declare)\\s+(framework|module)\\b",
          "captures": {
            "1": { "name": "keyword.control.declare.vertex" },
            "2": { "name": "storage.modifier.linkage.vertex" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vertex",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vertex" }
          },
          "end": "\"|(?=$)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vertex" }
          },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.other.raw.vertex",
          "begin": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vertex" }
          },
          "end": "`",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vertex" }
          }
        }
      ]
    },

    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.vertex",
          "match": "\\\\(?:['\"\\\\nrtvbf0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
        },
        {
          "name": "invalid.illegal.unknown-escape.vertex",
          "match": "\\\\."
        }
      ]
    },

    "char-literals": {
      "patterns": [
        {
          "name": "constant.character.vertex",
          "match": "(')((?:[^'\\\\\\n])|(\\\\(?:['\"\\\\nrtvbf0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})))(')",
          "captures": {
            "1": { "name": "punctuation.definition.character.begin.vertex" },
            "3": { "name": "constant.character.escape.vertex" },
            "4": { "name": "punctuation.definition.character.end.vertex" }
          }
        },
        {
          "name": "invalid.illegal.character.vertex",
          "match": "'[^'\\n]{2,}'"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hexadecimal.vertex",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*(?:\\.(?:[0-9a-fA-F](?:_?[0-9a-fA-F])*)?)?[pP][+-]?[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "invalid.illegal.numeric.missing-binary-exponent.vertex",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\.[0-9a-fA-F]*(?![pP])"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.vertex",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.vertex",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.vertex",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.float.decimal.vertex",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*)\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.vertex",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },

    "language-constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vertex",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.nil.vertex",
          "match": "\\bnil\\b"
        }
      ]
    },

    "expected": {
      "patterns": [
        {
          "match": "\\b(Expected)\\s*(\\()\\s*(error)\\b",
          "captures": {
            "1": { "name": "support.type.expected.vertex" },
            "2": { "name": "punctuation.section.parens.begin.vertex" },
            "3": { "name": "keyword.other.error.vertex" }
          }
        },
        {
          "name": "support.type.expected.vertex",
          "match": "\\b(Expected)\\b(?=\\s*\\()"
        }
      ]
    },

    "foreign-initializer": {
      "patterns": [
        {
          "match": "\\b(init)\\s+(func)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "storage.modifier.init.vertex" },
            "2": { "name": "storage.type.function.vertex" },
            "3": { "name": "entity.name.function.vertex" }
          }
        }
      ]
    },

    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(?:\\b(mut|var|shared)\\b\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?:\\[[^\\]]*\\])?\\s*(\\))\\s*(init|deinit)\\b",
          "captures": {
            "1": { "name": "storage.type.function.vertex" },
            "2": { "name": "punctuation.section.parens.begin.vertex" },
            "3": { "name": "variable.parameter.receiver.vertex" },
            "4": { "name": "punctuation.separator.colon.vertex" },
            "5": { "name": "storage.modifier.ownership.vertex" },
            "6": { "name": "entity.name.type.vertex" },
            "7": { "name": "punctuation.section.parens.end.vertex" },
            "8": { "name": "entity.name.function.constructor.vertex" }
          }
        },
        {
          "match": "\\b(func)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(?:\\b(mut|var|shared)\\b\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?:\\[[^\\]]*\\])?\\s*(\\))\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.vertex" },
            "2": { "name": "punctuation.section.parens.begin.vertex" },
            "3": { "name": "variable.parameter.receiver.vertex" },
            "4": { "name": "punctuation.separator.colon.vertex" },
            "5": { "name": "storage.modifier.ownership.vertex" },
            "6": { "name": "entity.name.type.vertex" },
            "7": { "name": "punctuation.section.parens.end.vertex" },
            "8": { "name": "entity.name.function.vertex" }
          }
        },
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.vertex" },
            "2": { "name": "entity.name.function.vertex" }
          }
        },
        {
          "name": "storage.type.function.vertex",
          "match": "\\bfunc\\b"
        }
      ]
    },

    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(struct|class|enum|constraint|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.vertex" },
            "2": { "name": "entity.name.type.vertex" }
          }
        }
      ]
    },

    "function-markers": {
      "patterns": [
        {
          "match": "(\\))\\s*\\b(test)\\b",
          "captures": {
            "1": { "name": "punctuation.section.parens.end.vertex" },
            "2": { "name": "storage.modifier.marker.vertex" }
          }
        }
      ]
    },

    "npu-namespace": {
      "patterns": [
        {
          "match": "\\b(npu)(\\.)(Expm1|Exp|Log1p|Log|MaxReduce|MinReduce|Abs|Sign|Floor|Ceil|Round|Sqrt|Rsqrt|Sin|Cos|Tanh|Tan|Sigmoid|IsFinite|Max|Min|Mod|Pow|Atan2|Dot|Select|Reshape|Transpose|Broadcast|Concat|Slice|Reverse|Pad|Sum|Product|Splat|Iota|Quantize|Dequantize)\\b",
          "captures": {
            "1": { "name": "support.class.namespace.npu.vertex" },
            "2": { "name": "punctuation.accessor.vertex" },
            "3": { "name": "support.function.npu.vertex" }
          }
        },
        {
          "match": "\\b(npu)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.class.namespace.npu.vertex" },
            "2": { "name": "punctuation.accessor.vertex" },
            "3": { "name": "invalid.illegal.unknown-npu-member.vertex" }
          }
        }
      ]
    },

    "namespaces": {
      "patterns": [
        {
          "name": "support.class.namespace.vertex",
          "match": "\\b(?:async|gpu|npu|chan)\\b(?=\\s*\\.)"
        }
      ]
    },

    "channel-methods": {
      "patterns": [
        {
          "match": "(\\.)\\s*(trySend|tryReceive|send|receive|close)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "support.function.channel.vertex" }
          }
        }
      ]
    },

    "removed-transfer": {
      "patterns": [
        {
          "match": "(\\.)\\s*(transfer)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "invalid.deprecated.transfer.vertex" }
          }
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.vertex",
          "match": "\\b(?:alignof|sizeof|reinterpret|resize|delete|upgrade|copy|drop|zero|addr|new)\\b"
        },
        {
          "name": "invalid.deprecated.transfer.vertex",
          "match": "\\btransfer\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vertex",
          "match": "\\b(?:break|case|continue|default|else|fallthrough|for|if|in|return|select|switch|while)\\b"
        },
        {
          "name": "keyword.control.defer.vertex",
          "match": "\\bdefer\\b"
        },
        {
          "name": "keyword.control.await.vertex",
          "match": "\\bawait\\b"
        },
        {
          "name": "keyword.control.import.vertex",
          "match": "\\bimport\\b"
        },
        {
          "name": "keyword.control.declare.vertex",
          "match": "\\bdeclare\\b"
        },
        {
          "name": "keyword.control.package.vertex",
          "match": "\\bpackage\\b"
        },
        {
          "name": "keyword.operator.cast.vertex",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.modifier.ownership.vertex",
          "match": "\\b(?:mut|unique|shared|weak)\\b"
        },
        {
          "name": "storage.modifier.marker.vertex",
          "match": "\\b(?:async|gpu|npu|thread)\\b"
        },
        {
          "name": "storage.type.abstract.vertex",
          "match": "\\babstract\\b"
        },
        {
          "name": "storage.type.vertex",
          "match": "\\b(?:let|var|struct|class|enum|constraint|type|chan|map|tensor|typed_ptr)\\b"
        }
      ]
    },

    "predeclared-types": {
      "patterns": [
        {
          "name": "support.type.primitive.vertex",
          "match": "\\b(?:int8|int16|int32|int64|int4|int|uint8|uint16|uint32|uint64|uint|byte|float32|float64|bool|char|string|bf16|fp8e4m3|fp8e5m2)\\b"
        }
      ]
    },

    "predeclared-constraints": {
      "patterns": [
        {
          "name": "support.type.constraint.vertex",
          "match": "\\b(?:any|comparable)\\b"
        }
      ]
    },

    "blank-identifier": {
      "patterns": [
        {
          "name": "variable.language.blank.vertex",
          "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
        }
      ]
    },

    "named-fields": {
      "patterns": [
        {
          "match": "(?<=[(,{])\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "variable.parameter.vertex" }
          }
        }
      ]
    },

    "enum-shorthand": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_)\\]])(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.other.enummember.vertex" }
          }
        }
      ]
    },

    "tuple-access": {
      "patterns": [
        {
          "match": "(?<=[A-Za-z0-9_)\\]])(\\.)([0-9])\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.other.member.tuple.vertex" }
          }
        }
      ]
    },

    "method-calls": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "entity.name.function.member.vertex" }
          }
        }
      ]
    },

    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.vertex" },
            "2": { "name": "variable.other.member.vertex" }
          }
        }
      ]
    },

    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.vertex",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.vertex",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.bitwise.shift.vertex",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.vertex",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.vertex",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.wrapping.vertex",
          "match": "&\\+|&-|&\\*"
        },
        {
          "name": "keyword.operator.variadic.vertex",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.vertex",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.vertex",
          "match": "->"
        },
        {
          "name": "keyword.operator.arithmetic.vertex",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.vertex",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.assignment.vertex",
          "match": "="
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.begin.vertex",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.vertex",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.vertex",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.vertex",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.vertex",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.vertex",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.vertex",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.vertex",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.vertex",
          "match": "\\."
        }
      ]
    }
  }
}