{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vertex",
  "scopeName": "source.vtx",
  "fileTypes": ["vtx", "vs"],

  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#package-clause" },
    { "include": "#build-clause" },
    { "include": "#import-clause" },
    { "include": "#declare-clause" },
    { "include": "#expected" },
    { "include": "#function-declaration" },
    { "include": "#type-declaration" },
    { "include": "#namespaces" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#predeclared-types" },
    { "include": "#constraints" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#dots" },
    { "include": "#member-access" },
    { "include": "#function-call" },
    { "include": "#type-name" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],

  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vtx",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.vtx" }
          }
        },
        {
          "name": "comment.block.vtx",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.vtx" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.vtx" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vtx",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vtx" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vtx" }
          },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.other.raw.vtx",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vtx" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vtx" }
          }
        },
        {
          "name": "string.quoted.single.vtx",
          "begin": "'",
          "end": "'|$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vtx" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vtx" }
          },
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },

    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.vtx",
          "match": "\\\\(?:[\\\\'\"nrtvbf0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
        },
        {
          "name": "invalid.illegal.unknown-escape.vtx",
          "match": "\\\\."
        }
      ]
    },

    "package-clause": {
      "match": "\\b(package)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.package.vtx" },
        "2": { "name": "entity.name.namespace.vtx" }
      }
    },

    "build-clause": {
      "match": "\\b(build)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.build.vtx" },
        "2": { "name": "support.constant.buildtag.vtx" }
      }
    },

    "import-clause": {
      "match": "\\b(import)\\b",
      "captures": {
        "1": { "name": "keyword.control.import.vtx" }
      }
    },

    "declare-clause": {
      "match": "\\b(declare)\\s+(framework|module)\\b",
      "captures": {
        "1": { "name": "keyword.control.declare.vtx" },
        "2": { "name": "keyword.other.declare-kind.vtx" }
      }
    },

    "expected": {
      "match": "\\b(Expected)\\s*(\\()\\s*(error)?",
      "captures": {
        "1": { "name": "support.type.expected.vtx" },
        "2": { "name": "punctuation.section.parens.begin.vtx" },
        "3": { "name": "keyword.other.error.vtx" }
      }
    },

    "function-declaration": {
      "patterns": [
        {
          "comment": "method / init / deinit — func (recv: Type) name",
          "match": "\\b(func)\\s+(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(?:(mut|var|shared)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?:\\s*\\[[^\\]]*\\])?\\s*(\\))\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.vtx" },
            "2": { "name": "punctuation.section.parens.begin.vtx" },
            "3": { "name": "variable.parameter.receiver.vtx" },
            "4": { "name": "punctuation.separator.colon.vtx" },
            "5": { "name": "storage.modifier.ownership.vtx" },
            "6": { "name": "entity.name.type.vtx" },
            "7": { "name": "punctuation.section.parens.end.vtx" },
            "8": { "name": "entity.name.function.vtx" }
          }
        },
        {
          "comment": "plain declaration — func name",
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.vtx" },
            "2": { "name": "entity.name.function.vtx" }
          }
        },
        {
          "comment": "func type / anonymous function",
          "name": "storage.type.function.vtx",
          "match": "\\bfunc\\b"
        }
      ]
    },

    "type-declaration": {
      "patterns": [
        {
          "match": "\\b(struct|class|enum|constraint)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.vtx" },
            "2": { "name": "entity.name.type.vtx" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.vtx" },
            "2": { "name": "entity.name.type.vtx" }
          }
        }
      ]
    },

    "namespaces": {
      "comment": "grammar.md 5.1 NamespaceExpression — a launch keyword before `.` is a namespace, not a launch",
      "name": "support.class.namespace.vtx",
      "match": "\\b(?:async|gpu|npu|chan)\\b(?=\\s*\\.)"
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vtx",
          "match": "\\b(?:break|case|continue|default|defer|else|fallthrough|for|if|in|return|select|switch|while)\\b"
        },
        {
          "name": "keyword.control.flow.vtx",
          "match": "\\b(?:await|thread)\\b"
        },
        {
          "name": "storage.modifier.marker.vtx",
          "match": "\\b(?:async|gpu|npu|test)\\b"
        },
        {
          "name": "keyword.operator.cast.vtx",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.type.vtx",
          "match": "\\b(?:let|var|struct|class|enum|type|constraint|chan|map|vector|tensor|typed_ptr|abstract)\\b"
        },
        {
          "name": "storage.modifier.ownership.vtx",
          "match": "\\b(?:mut|unique|shared|weak)\\b"
        },
        {
          "name": "keyword.other.contextual.vtx",
          "match": "\\b(?:init|deinit|framework|module)\\b"
        }
      ]
    },

    "constants": {
      "name": "constant.language.vtx",
      "match": "\\b(?:true|false|nil)\\b"
    },

    "predeclared-types": {
      "name": "support.type.primitive.vtx",
      "match": "\\b(?:int8|int16|int32|int64|int|uint8|uint16|uint32|uint64|uint|byte|float32|float64|bool|char|string)\\b"
    },

    "constraints": {
      "name": "support.type.constraint.vtx",
      "match": "\\b(?:any|comparable)\\b"
    },

    "builtins": {
      "comment": "semantics.md 1.8 reserved names, in call position",
      "name": "support.function.builtin.vtx",
      "match": "\\b(?:new|delete|resize|copy|zero|addr|sizeof|alignof|reinterpret|upgrade|unique|shared|weak|drop|panic|blend|min|max|clamp)\\b(?=\\s*[\\(\\[])"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hexadecimal.vtx",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:\\.[0-9A-Fa-f_]*)?[pP][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.vtx",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.vtx",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.vtx",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.vtx",
          "match": "(?<![\\w.])[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)(?![\\w.])"
        },
        {
          "name": "constant.numeric.integer.decimal.vtx",
          "match": "(?<![\\w.])[0-9][0-9_]*\\b"
        }
      ]
    },

    "dots": {
      "comment": "matched before member access so `0..5` never reads as a tuple index",
      "patterns": [
        {
          "name": "keyword.operator.variadic.vtx",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.vtx",
          "match": "\\.\\."
        }
      ]
    },

    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\[[^\\[\\]]*\\])?\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.vtx" },
            "2": { "name": "entity.name.function.method.vtx" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.vtx" },
            "2": { "name": "variable.other.member.vtx" }
          }
        },
        {
          "comment": "tuple positional access — x.0 / x.1",
          "match": "(\\.)([0-9]+)",
          "captures": {
            "1": { "name": "punctuation.accessor.vtx" },
            "2": { "name": "variable.other.member.tuple.vtx" }
          }
        }
      ]
    },

    "function-call": {
      "name": "entity.name.function.call.vtx",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:\\[[^\\[\\]]*\\])?\\s*\\()"
    },

    "type-name": {
      "comment": "heuristic: a capitalized identifier not in call position is a type",
      "name": "entity.name.type.vtx",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.vtx", "match": "->" },
        { "name": "keyword.operator.identity.vtx", "match": "===|!==" },
        { "name": "keyword.operator.assignment.vtx", "match": "<<=|>>=" },
        { "name": "keyword.operator.assignment.vtx", "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=" },
        { "name": "keyword.operator.comparison.vtx", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.vtx", "match": "&&|\\|\\|" },
        { "name": "keyword.operator.arithmetic.wrapping.vtx", "match": "&\\+|&-|&\\*" },
        { "name": "keyword.operator.bitwise.shift.vtx", "match": "<<|>>" },
        { "name": "keyword.operator.comparison.vtx", "match": "<|>" },
        { "name": "keyword.operator.logical.vtx", "match": "!" },
        { "name": "keyword.operator.arithmetic.vtx", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.bitwise.vtx", "match": "[&|^~]" },
        { "name": "keyword.operator.assignment.vtx", "match": "=" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.vtx", "match": "[{}]" },
        { "name": "punctuation.section.parens.vtx", "match": "[()]" },
        { "name": "punctuation.section.brackets.vtx", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.comma.vtx", "match": "," },
        { "name": "punctuation.separator.colon.vtx", "match": ":" },
        { "name": "punctuation.accessor.vtx", "match": "\\." }
      ]
    }
  }
}