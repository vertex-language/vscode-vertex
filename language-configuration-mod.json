{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ]
  ],
  "wordPattern": "[^\\s()]+",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\w+\\s*\\(\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*\\)"
  },
  "folding": {
    "markers": {
      "start": "^\\s*\\w+\\s*\\(\\s*(//.*)?$",
      "end": "^\\s*\\)"
    }
  }
}
