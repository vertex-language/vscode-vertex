{
  "$schema": "https://json.schemastore.org/package",
  "name": "vscode-vertex",
  "displayName": "Vertex Language Support",
  "description": "Syntax highlighting for the Vertex programming language: .vs source files and .vir Vertex IR files",
  "version": "4.0.0",
  "publisher": "vertex-language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vertex-language/vscode-vertex"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "vertex",
        "aliases": ["Vertex", "vertex"],
        "extensions": [".vs"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "vertex-ir",
        "aliases": ["Vertex IR", "vertex-ir", "vir"],
        "extensions": [".vir"],
        "configuration": "./language-configuration-ir.json"
      }
    ],
    "grammars": [
      {
        "language": "vertex",
        "scopeName": "source.vtx",
        "path": "./syntaxes/vertex.tmLanguage.json"
      },
      {
        "language": "vertex-ir",
        "scopeName": "source.vtxir",
        "path": "./syntaxes/vertex-ir.tmLanguage.json"
      },
      {
        "scopeName": "markdown.vertex.codeblock",
        "path": "./syntaxes/vertex-markdown-injection.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.vertex": "vertex",
          "meta.embedded.block.vertex-ir": "vertex-ir"
        }
      }
    ]
  }
}
